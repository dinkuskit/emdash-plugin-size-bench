{
	// Real-Cloudflare variant of the EmDash plugin size benchmark.
	// Deploy with `npx wrangler deploy` from this folder (needs a Workers
	// account with Worker Loader access), then run `node run-edge.mjs <url>`.
	"name": "emdash-plugin-size-bench",
	"main": "src/index.js",
	"compatibility_date": "2026-08-20",
	// enable_ctx_exports: the plugin bridge is made from this Worker's own exports,
	// as EmDash does; a deploy without the flag had no callable BenchBridge.
	"compatibility_flags": ["nodejs_compat", "enable_ctx_exports"],
	"worker_loaders": [{ "binding": "LOADER" }],
	"assets": { "directory": "../payloads", "binding": "ASSETS", "run_worker_first": true },
	"limits": { "cpu_ms": 300000 },
	"observability": { "enabled": true }
}
